# =============================================================================
# YogaConnect India - Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to version control.
# =============================================================================

# =============================================================================
# 1. Google Firebase Authentication & Cloud Firestore (Web SDK)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# =============================================================================
# 2. Firebase Console Configuration Guide:
# - Enable Providers: Firebase Console -> Authentication -> Sign-in method -> Email/Password & Google
# - Add Authorized Domains: Firebase Console -> Authentication -> Settings -> Authorized Domains
#   Add:
#     - localhost
#     - yoga-connect-india-1huq.vercel.app
# - Deploy Firestore Security Rules:
#   npx -y firebase-tools@latest deploy --only firestore:rules
# =============================================================================

# =============================================================================
# 3. Supabase / Postgres Database Configuration (Existing Hybrid Store)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://rrsisnnusllokxceszsu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rrsisnnusllokxceszsu.supabase.co:5432/postgres
