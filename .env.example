# =============================================================================
# YogaConnect India - Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to version control.
# =============================================================================

# 1. Supabase Project Configuration (Obtain from: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://fpzfnbrgxgegujcijahx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# 2. Direct Postgres Database Connection (For migrations / server scripts)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fpzfnbrgxgegujcijahx.supabase.co:5432/postgres

# =============================================================================
# Google OAuth Configuration Reference (Configured in Supabase Dashboard)
# =============================================================================
# - Google OAuth credentials are NOT stored in frontend env files.
# - Configure Client ID & Secret directly in:
#   Supabase Dashboard -> Authentication -> Providers -> Google
# - In Google Cloud Console, Authorized Redirect URI must be:
#   https://<YOUR-PROJECT-REF>.supabase.co/auth/v1/callback
# - In Supabase Dashboard -> URL Configuration:
#   Site URL: http://localhost:3000 (development) or https://your-production-domain.com
#   Redirect URLs: http://localhost:3000/auth/callback, https://your-production-domain.com/auth/callback
